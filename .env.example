# Copy to .env and adjust. All values are optional — the defaults shown are what
# the bundled docker-compose.yml provides. Nothing here is baked into the image:
# every value is read at runtime.

# --- Server side (Nitro proxy). Resolved INSIDE the container network. ---
NUXT_NATS_MONITOR_URL=http://nats:8222
NUXT_NATS_CLIENT_URL=nats://nats:4222

# HTTP basic auth for the NATS monitoring endpoint. Use these OR the token below.
NUXT_NATS_MONITOR_USER=
NUXT_NATS_MONITOR_PASSWORD=

# Bearer token for the monitoring endpoint. Takes precedence over basic auth.
NUXT_NATS_MONITOR_TOKEN=

# Timeout for monitoring calls, in milliseconds.
NUXT_NATS_MONITOR_TIMEOUT_MS=8000

# --- Client side (browser). Resolved BY THE BROWSER, so it must be reachable
# from outside the container network. ---
NUXT_PUBLIC_NATS_WS_URL=ws://localhost:8080
NUXT_PUBLIC_NATS_CONNECTION_NAME=nats-webui

# --- Where the WebUI itself listens. ---
NITRO_HOST=0.0.0.0
NITRO_PORT=3000